name: Parse Cian Daily

on:
  schedule:
    # Запускаем каждый день в 9 утра МСК (6 UTC)
    - cron: '0 6 * * *'
  
  # Также можно запустить вручную
  workflow_dispatch:

jobs:
  parse:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      
      - name: Run parser
        run: |
          python3 << 'EOF'
          from cian_parser import CianParser
          import json
          from datetime import datetime
          
          parser = CianParser(headless=True)
          
          try:
              filters = {
                  'city': 'moskva',
                  'price_max': 20_000_000,
                  'rooms': [1, 2, 3],
              }
              
              listings = parser.search_listings(filters, max_pages=2)
              
              date_str = datetime.now().strftime('%Y-%m-%d')
              filename = f'data/listings_{date_str}.json'
              
              parser.save_to_json(listings, filename)
              
              print(f"✅ Found {len(listings)} listings")
              print(f"💾 Saved to {filename}")
          
          finally:
              parser.close()
          
          EOF
      
      - name: Commit results
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add data/
          git commit -m "🤖 Daily parse: $(date +'%Y-%m-%d')" || true
          git push || true
      
      - name: Send Telegram notification
        if: always()
        run: |
          python3 << 'EOF'
          import requests
          import os
          from datetime import datetime
          
          TOKEN = "${{ secrets.TELEGRAM_BOT_TOKEN }}"
          CHAT_ID = "${{ secrets.TELEGRAM_CHAT_ID }}"
          
          if TOKEN and CHAT_ID:
              status = "${{ job.status }}"
              emoji = "✅" if status == "success" else "❌"
              msg = f"{emoji} Cian parse {status}\n{datetime.now().strftime('%d.%m.%Y %H:%M')}"
              try:
                  requests.post(
                      f"https://api.telegram.org/bot{TOKEN}/sendMessage",
                      json={'chat_id': CHAT_ID, 'text': msg}
                  )
              except:
                  pass
          EOF
